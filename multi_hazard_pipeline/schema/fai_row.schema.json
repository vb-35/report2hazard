{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FAI Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segment",
    "event",
    "process",
    "generalized_category",
    "interaction_type",
    "sediment_transport_phase"
  ],
  "properties": {
    "segment": {
      "type": "integer",
      "minimum": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "process": {
      "type": "string",
      "minLength": 1
    },
    "generalized_category": {
      "type": "string"
    },
    "interaction_type": {
      "type": "string"
    },
    "sediment_transport_phase": {
      "type": "string"
    }
  }
}
